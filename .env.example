# Supabase — required. Create a free project at https://database.new
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — protects the public "add/edit/delete article" endpoints with a
# shared secret. Leave unset for local development (writes stay open).
ADMIN_TOKEN=
